{
  "name": "dsh-mexplore",
  "version": "0.3.3",
  "private": true,
  "license": "MIT",
  "description": "Mexplore: long-term memory for DeepSeek Harness, stored as a filesystem graph — direct memory tools, a memory agent, and a graph panel",
  "type": "module",
  "main": "lib/entry.js",
  "exports": {
    ".": "./lib/entry.js",
    "./graph": "./lib/graph.js",
    "./package.json": "./package.json",
    "./tool": "./lib/tool.js",
    "./direct": "./lib/bundle/direct.js",
    "./agent": "./lib/bundle/agent.js",
    "./agent-tools": "./lib/bundle/agent-tools.js",
    "./history": "./lib/bundle/history.js",
    "./import": "./lib/import/index.js",
    "./ui": "./lib/bundle/ui.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/bundle/*.json",
    "./icon": "./icon.svg",
    "./direct/locale/*.json": "./locale/direct/*.json",
    "./direct/icon": "./icon.svg",
    "./agent/locale/*.json": "./locale/agent/*.json",
    "./agent/icon": "./icon.svg",
    "./agent-tools/locale/*.json": "./locale/agent-tools/*.json",
    "./agent-tools/icon": "./icon.svg",
    "./history/locale/*.json": "./locale/history/*.json",
    "./history/icon": "./icon.svg",
    "./ui/locale/*.json": "./locale/ui/*.json",
    "./ui/icon": "./icon.svg"
  },
  "scripts": {
    "test": "node --test test/graph.test.js test/interop.test.js test/plugin.test.js test/snapshot.test.js test/prompt-snapshot.test.js test/index-budget.test.js test/crash.test.js test/race.test.js test/refusals.test.js test/write-guards.test.js test/bundle.test.js test/bundle-provenance.test.js test/provenance.test.js test/provenance-cli.test.js test/ui.test.js test/history.test.js test/import-adapter.test.js",
    "test:release": "node --test test/*.test.js",
    "build:ui": "node scripts/build-ui.mjs"
  },
  "files": [
    "lib/**/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/**/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "devDependencies": {
    "d3": "7.9.2",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "marked": "18.1.3",
    "postcss": "8.5.32",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1"
  }
}
