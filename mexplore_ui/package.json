{
  "name": "mexplore-ui",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "description": "Read-only localhost explorer + token/latency dashboard for the mexplore memory agent",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.10"
  },
  "main": "./src/server/cli.ts",
  "exports": {
    ".": "./src/server/cli.ts",
    "./plugin": "./src/plugin.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/server/**/*",
    "src/shared/**/*",
    "src/plugin.ts",
    "dist/**/*",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "package.json"
  ],
  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "start": "bun src/server/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "agent:install": "bun scripts/agent.ts install",
    "agent:uninstall": "bun scripts/agent.ts uninstall"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "d3": "^7.9.2",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
